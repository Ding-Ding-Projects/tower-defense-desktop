{
  "name": "tower-defense-desktop",
  "productName": "Tower Defence Desktop",
  "version": "0.1.0",
  "description": "A deterministic tower defense game for Windows, with stat parity to Tower Defense Simulator.",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.render.json && tsc -p tsconfig.tools.json",
    "validate:data": "node tools/validate-data.mjs",
    "check:determinism": "node tools/check-determinism.mjs",
    "test": "node --test \"tests/**/*.test.js\" \"tests/**/*.test.mjs\"",
    "check": "npm run typecheck && npm run check:determinism && npm run validate:data && npm run check:site && npm run check:docs && npm test",
    "count": "node tools/count-lines.mjs",
    "dist": "electron-builder --win squirrel --publish never",
    "check:site": "node tools/check-site-contract.mjs",
    "check:docs": "node tools/check-docs-bundle.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-builder-squirrel-windows": "^26.0.12",
    "typescript": "^5.7.2"
  },
  "build": {
    "appId": "com.dingdingprojects.towerdefencedesktop",
    "productName": "Tower Defence Desktop",
    "files": [
      "electron/**/*",
      "src/**/*",
      "index.html",
      "styles.css",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "squirrel",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "forceCodeSigning": false,
      "signAndEditExecutable": false
    },
    "squirrelWindows": {
      "name": "TowerDefenceDesktop",
      "artifactName": "TowerDefenceDesktop-Setup-${version}.${ext}",
      "msi": false
    }
  },
  "author": {
    "name": "Ding Ding Projects"
  },
  "license": "MIT"
}
